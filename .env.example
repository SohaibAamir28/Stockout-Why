# ---------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored - never commit it.
# ---------------------------------------------------------------

# DATA - Zetaris (runs in Docker on the 16 GB host)
# If Zetaris runs on another machine, use that machine's reachable
# address here, NOT localhost.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# POWER - Meterless Nightshift (the AI provider our app calls)
# Both values come from Nightshift's Console, top right.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_APP=stockout-why

# Pin a Nemotron route for unambiguous NVIDIA award evidence;
# meterless/auto may route elsewhere. List the routes your Nightshift
# offers with GET /v1/models (npm run smoke prints the first few).
# Verified: openrouter/nvidia/nemotron-3.5-lightning
METERLESS_MODEL=meterless/auto

# No provider key belongs here (NVIDIA, OpenRouter or any other). It
# goes in Nightshift's Setup -> Providers tab; Nightshift makes the call.

# The Zetaris datasource the business tables are registered under.
# Queries read <ZETARIS_SOURCE>.<table>.
ZETARIS_SOURCE=retail

# Retail database (a local Postgres container on the Zetaris Docker
# network, no host port). Leave blank: register_zetaris.ts generates it.
RETAIL_DB_PASSWORD=
